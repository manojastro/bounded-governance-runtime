{
 "apiVersion": "apps/v1",
 "kind": "Deployment",
 "metadata": {
  "name": "payments-api",
  "namespace": "payments",
  "labels": {
   "app": "payments-api",
   "bounded-managed": "true"
  }
 },
 "spec": {
  "replicas": 1,
  "template": {
   "metadata": {
    "labels": {
     "app": "payments-api"
    }
   },
   "spec": {
    "containers": [
     {
      "name": "payments-api",
      "image": "payments-api:2.4",
      "env": []
     }
    ]
   }
  }
 }
}