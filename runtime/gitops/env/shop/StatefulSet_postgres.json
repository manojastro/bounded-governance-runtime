{
 "apiVersion": "apps/v1",
 "kind": "StatefulSet",
 "metadata": {
  "name": "postgres",
  "namespace": "shop",
  "labels": {
   "app": "postgres",
   "criticality": "tier-0",
   "bounded-managed": "true"
  }
 },
 "spec": {
  "replicas": 1,
  "template": {
   "metadata": {
    "labels": {
     "app": "postgres"
    }
   },
   "spec": {
    "containers": [
     {
      "name": "postgres",
      "image": "postgres:16",
      "env": []
     }
    ]
   }
  }
 }
}